# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않는다. 실제 키는 여기 넣지 말고 .env 에만 둔다.
# 포크한 개발자는 각자 자기 키를 넣고 자기 비용으로 로컬에서 실행한다.

# 사용할 공급자: anthropic | openai | gemini | fake
# fake 는 키 없이 스트리밍 배선을 확인하는 로컬 더미 공급자다.
LLM_PROVIDER=fake

# 필수(anthropic 사용 시): 본인 Anthropic API 키.
ANTHROPIC_API_KEY=

# 선택: 사용할 모델. 미설정 시 claude-opus-4-8.
# 비용을 낮추려면 claude-sonnet-5 또는 claude-haiku-4-5 로 바꾼다.
ANTHROPIC_MODEL=claude-opus-4-8

# 필수(openai 사용 시): 본인 OpenAI API 키.
OPENAI_API_KEY=

# 선택: 사용할 모델. 미설정 시 gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# 필수(gemini 사용 시): 본인 Google Gemini API 키.
GEMINI_API_KEY=

# 선택: 사용할 모델. 미설정 시 gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash

# 선택: 레이트 리밋 백엔드 (memory | redis). 미설정 시 memory.
RATE_LIMIT_BACKEND=memory
# redis 사용 시 연결 (미설정 시 localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# 선택: 시맨틱 캐시 (유사 프롬프트 응답 재사용). 미설정 시 false.
CACHE_ENABLED=false
